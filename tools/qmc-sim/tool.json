{
  "slug": "qmc-sim",
  "version": "1.0.0",
  "productName": "qmc-sim",
  "appId": "it.bitland.qmcsim",
  "description": "Quine-McCluskey logic minimization simulator.",
  "author": "PIPELINESIM",
  "license": "MIT",
  "entry": "index.html",
  "webAssets": [
    "index.html",
    "styles.css",
    "app.js"
  ],
  "examIntegrity": {
    "enabled": true,
    "watermark": true,
    "requestPrefix": "QMC",
    "requestCodeLength": 20,
    "publicKeyEnv": "QMC_SIM_UNLOCK_PUBLIC_KEY",
    "publicKeyFile": "../../private/qmc-public.pem",
    "lockWhenUnconfigured": true
  },
  "electron": {
    "width": 1480,
    "height": 920,
    "minWidth": 1024,
    "minHeight": 700,
    "backgroundColor": "#f5f7f4",
    "macCategory": "public.app-category.education",
    "linuxCategory": "Education"
  }
}
