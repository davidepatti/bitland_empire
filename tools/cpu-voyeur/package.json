{
  "name": "cpu-voyeur",
  "version": "1.0.0",
  "description": "Clickable MIPS64 pipeline/datapath instruction demo.",
  "main": "electron-main.js",
  "author": "PIPELINESIM",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check app.js && node --check electron-main.js && node --check scripts/after-pack.js && bash -n launch.sh && bash -n scripts/package-electron.sh",
    "dist": "npm run dist:mac && npm run dist:win && npm run dist:linux",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "it.bitland.cpuvoyeur",
    "productName": "CPU Voyeur",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "pipeline_diagram.png",
      "electron-main.js",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  }
}
