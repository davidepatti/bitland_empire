#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PRIVATE_KEY="$ROOT_DIR/private/qmc-private.pem"
STUDENT_ID="${QMC_SIM_STUDENT:-manual}"

if [[ "$#" -ne 1 ]]; then
  echo "Usage: ./unlock <QMC-computer-code>" >&2
  exit 1
fi

if [[ ! -f "$PRIVATE_KEY" ]]; then
  echo "Missing private key: $PRIVATE_KEY" >&2
  echo "Create it once with:" >&2
  echo "  node scripts/electron/qmc-exam-code.js keygen --public private/qmc-public.pem --private private/qmc-private.pem" >&2
  exit 1
fi

node "$ROOT_DIR/scripts/electron/qmc-exam-code.js" unlock \
  --private "$PRIVATE_KEY" \
  --student "$STUDENT_ID" \
  --request "$1"
